# Copy to .env (git-ignored) and fill in. Never commit real values.
# The deployed app needs none of these; they are only for rebuilding the research.

# Free Google AI Studio key for the Gemma agent desk and catalyst extraction.
SB_LLM_API_KEY=

# SEC EDGAR asks for a project name and a contact email; it is not a login or a key.
# Example value: "Project_AI_in_Finance name@example.com"
SB_SEC_USER_AGENT=

# Optional storage root; relative values resolve against the repository root.
# SB_WORKSPACE_ROOT=data/research_v2

# Optional: the app reads this bundle instead of demo/app_bundle.
# SB_APP_BUNDLE=demo/app_bundle

# Optional: free Alpha Vantage key, only for the alternative 2024-2025 news adapter
# (docs/NEWS_2024_2025.md). The adopted TickerTick source needs no key.
# ALPHAVANTAGE_API_KEY=
